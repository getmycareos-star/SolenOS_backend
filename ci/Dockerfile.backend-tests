FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends antiword ca-certificates curl tesseract-ocr tesseract-ocr-eng; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY backend ./backend
RUN python -m pip install --upgrade pip && \
    python -m pip install -e ./backend pytest httpx 'psycopg[binary]'
