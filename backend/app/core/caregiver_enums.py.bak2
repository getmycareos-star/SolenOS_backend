"""Caregiver-related enumerations for SolenOS."""

from enum import Enum


class ResponsibilityStatus(str, Enum):
    """Status of a caregiver responsibility."""
    ACTIVE = "active"
    INACTIVE = "inactive"
    PENDING = "pending"
    COMPLETED = "completed"
    ON_HOLD = "on_hold"


class AcceptanceStatus(str, Enum):
    """Acceptance status of a caregiver responsibility."""
    OFFERED = "offered"
    ACCEPTED = "accepted"
    DECLINED = "declined"
    WITHDRAWN = "withdrawn"
    NEGOTIATING = "negotiating"


class CaregiverAvailabilityStatus(str, Enum):
    """Availability status of a caregiver."""
    AVAILABLE = "available"
    UNAVAILABLE = "unavailable"
    LIMITED = "limited"
    UNKNOWN = "unknown"


class CaregiverParticipationCategory(str, Enum):
    """Category of caregiver participation."""
    FAMILY = "family"
    PROFESSIONAL = "professional"
    VOLUNTEER = "volunteer"
    OTHER = "other"


class CaregiverProximityCategory(str, Enum):
    """Proximity of caregiver to care recipient."""
    CLOSE = "close"
    MODERATE = "moderate"
    DISTANT = "distant"
    UNKNOWN = "unknown"


class ClaimType(str, Enum):
    """Type of a caregiver claim."""
    SYMPTOM = "symptom"
    BEHAVIOR = "behavior"
    MEDICATION_EFFECT = "medication_effect"
    MOOD = "mood"
    COGNITION = "cognition"


class InformationVisibility(str, Enum):
    """Visibility of information shared among caregivers."""
    PRIVATE = "private"
    SHARED = "shared"
    RESTRICTED = "restricted"


class CommunicationDirection(str, Enum):
    """Direction of communication."""
    TO_ONE = "to_one"
    TO_GROUP = "to_group"
    BROADCAST = "broadcast"


class CaregiverAcknowledgmentLevel(str, Enum):
    """Level of acknowledgment of a communication."""
    NONE = "none"
    SENT = "sent"
    DELIVERED = "delivered"
    READ = "read"
    REPLIED = "replied"


class CaregiverActivityType(str, Enum):
    """Type of caregiver activity."""
    APPOINTMENT = "appointment"
    MEDICATION = "medication"
    MEAL_PREPARATION = "meal_preparation"
    HYGIENE = "hygiene"
    EXERCISE = "exercise"
    SOCIAL = "social"
    OTHER = "other"


class CareNetworkRelationshipType(str, Enum):
    """Type of care network relationship."""
    PRIMARY = "primary"
    SECONDARY = "secondary"
    TERTIARY = "tertiary"
    PROFESSIONAL = "professional"
    FAMILY = "family"
    FRIEND = "friend"
    VOLUNTEER = "volunteer"
    OTHER = "other"


class PerspectiveConflictStatus(str, Enum):
    """Status of a perspective conflict."""
    UNRESOLVED = "unresolved"
    RESOLVED = "resolved"
    MEDIATED = "mediated"
    ESCALATED = "escalated"


class DuplicateActionStatus(str, Enum):
    """Status of a duplicate action detection."""
    POTENTIAL_DUPLICATE = "potential_duplicate"
    CONFIRMED_DUPLICATE = "confirmed_duplicate"
    RESOLVED = "resolved"
    IGNORED = "ignored"
class CaregiverRoleType(str, Enum):
    """Role of a caregiver."""
    PRIMARY = "primary"
    SECONDARY = "secondary"
    DELEGATE = "delegate"
    RESPITE = "respite"
    SPECIALIST = "specialist"
    OBSERVER = "observer"


class ResponsibilityAcceptanceStatus(str, Enum):
    """Acceptance status of a caregiver responsibility."""
    OFFERED = "offered"
    ACCEPTED = "accepted"
    DECLINED = "declined"
    WITHDRAWN = "withdrawn"
    NEGOTIATING = "negotiating"


class HandoffAcceptanceStatus(str, Enum):
    """Acceptance status of a handoff."""
    OFFERED = "offered"
    ACCEPTED = "accepted"
    DECLINED = "declined"
    WITHDRAWN = "withdrawn"


class ObservationType(str, Enum):
    """Type of observation."""
    DIRECT = "direct"
    INDIRECT = "indirect"
    ASSUMED = "assumed"


class CoverageGapStatus(str, Enum):
    """Status of a coverage gap."""
    OPEN = "open"
    CLOSED = "closed"
    RESOLVED = "resolved"


class IdentityMatchConfidence(str, Enum):
    """Confidence in identity matching."""
    CERTAIN = "certain"
    UNCERTAIN = "uncertain"
    UNKNOWN = "unknown"


class CaregiverInvolvementStatus(str, Enum):
    """Involvement status of a caregiver."""
    ACTIVE = "active"
    INACTIVE = "inactive"
    ON_LEAVE = "on_leave"
