"""Caregiver-related enumerations for SolenOS."""

from enum import Enum


class ResponsibilityStatus(str, Enum):
    """Status of a caregiver responsibility."""
    ACTIVE = "active"
    INACTIVE = "inactive"
    PENDING = "pending"
    COMPLETED = "completed"
    ON_HOLD = "on_hold"


class AcceptanceStatus(str, Enum):
    """Acceptance status of a caregiver responsibility."""
    OFFERED = "offered"
    ACCEPTED = "accepted"
    DECLINED = "declined"
    WITHDRAWN = "withdrawn"
    NEGOTIATING = "negotiating"


class CaregiverAvailabilityStatus(str, Enum):
    """Availability status of a caregiver."""
    AVAILABLE = "available"
    UNAVAILABLE = "unavailable"
    LIMITED = "limited"
    UNKNOWN = "unknown"

class CaregiverParticipationCategory(str, Enum):
    """Category of caregiver participation."""
    FAMILY = "family"
    PROFESSIONAL = "professional"
    VOLUNTEER = "volunteer"
    OTHER = "other"


class ClaimType(str, Enum):
    """Type of a caregiver claim."""
    SYMPTOM = "symptom"
    BEHAVIOR = "behavior"
    MEDICATION_EFFECT = "medication_effect"
    MOOD = "mood"
    COGNITION = "cognition"


class InformationVisibility(str, Enum):
    """Visibility of information shared among caregivers."""
    PRIVATE = "private"
    SHARED = "shared"
    RESTRICTED = "restricted"
