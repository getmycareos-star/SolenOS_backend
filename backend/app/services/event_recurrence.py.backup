"""Event Recurrence Grouping Service.

Detects and manages recurrence patterns in care events.
Groups recurring events into meaningful patterns for analysis.

Architecture:
  - Temporal clustering for pattern detection
  - Semantic similarity for same-type grouping
  - Statistical analysis (average interval, frequency, trend)
  - Representative event selection
"""

from __future__ import annotations

import statistics
from datetime import datetime, timezone, timedelta
from typing import Any, Dict, List, Optional, Set, Tuple
from enum import Enum
from dataclasses import dataclass, field
from sqlalchemy.orm import Session

from app.core.event_enums import (
    CareEventType,
    CareEventSubtype,
    CareEventStatus,
    EventMentionType,
    RecurrenceDetectionMethod,
    EventLifecycleStage,
)
from app.core.temporal_enums import (
    TemporalPrecision,
    TemporalMode,
    TemporalStatus,
    TemporalRelationType,
    TemporalResolutionStatus,
)
from app.schemas.temporal import (
    RecurrenceFrequency,
    TrendType,
)
from app.models.care_event import (
    CareEvent,
    CareEventRecurrenceGroup,
    CareEventRelationship,
)


@dataclass
class RecurrencePattern:
    """Detected recurrence pattern."""
    frequency: RecurrenceFrequency
    average_interval_days: Optional[float]
    interval_std_dev_days: Optional[float]
    occurrences: List[str]  # Event IDs
    first_occurrence: Optional[datetime]
    last_occurrence: Optional[datetime]
    trend: TrendType
    confidence: float
    pattern_type: Optional[str]
    detection_method: RecurrenceDetectionMethod
    evidence_ids: List[str]


class EventRecurrenceService:
    """Detects and manages recurrence patterns in care events.

    Groups recurring events (falls, medication adherence, symptom episodes, etc.)
    into recurrence groups for temporal intelligence analysis.
    """

    # Minimum occurrences to consider a pattern
    MIN_OCCURRENCES = 2
    # Minimum confidence to form a group
    MIN_CONFIDENCE = 0.6
    # Maximum gap between occurrences (days) to include in group
    MAX_GAP_DAYS = 180

    def __init__(self):
        pass

    def detect_recurrence_patterns(
        self,
        db: Session,
        person_id: str,
        event_type: Optional[CareEventType] = None,
        min_occurrences: int = 2,
        max_gap_days: int = 180,
    ) -> List[RecurrencePattern]:
        """Detect recurrence patterns for a person's events."""
        query = db.query(CareEvent).filter(
            CareEvent.person_id == person_id,
            CareEvent.lifecycle_stage != EventLifecycleStage.INVALIDATED,
            CareEvent.mention_type != EventMentionType.HISTORICAL_REFERENCE,
            CareEvent.event_time.isnot(None),
        )

        if event_type:
            query = query.filter(CareEvent.event_type == event_type)

        events = query.order_by(CareEvent.event_time.asc()).all()

        if len(events) < min_occurrences:
            return []

        # Group by event type + subtype for pattern detection
        type_groups: Dict[Tuple[CareEventType, Optional[str]], List[CareEvent]] = {}
        for event in events:
            key = (event.event_type, event.event_subtype)
            if key not in type_groups:
                type_groups[key] = []
            type_groups[key].append(event)

        patterns: List[RecurrencePattern] = []

        for (etype, subtype), group_events in type_groups.items():
            if len(group_events) < min_occurrences:
                continue

            # Sort by event time
            sorted_events = sorted(group_events, key=lambda e: e.event_time or datetime.min)
            pattern = self._analyze_pattern(db, sorted_events, etype, subtype, max_gap_days)

            if pattern and pattern.confidence >= self.MIN_CONFIDENCE:
                patterns.append(pattern)

        return patterns

    def _analyze_pattern(
        self,
        db: Session,
        events: List[CareEvent],
        event_type: CareEventType,
        subtype: Optional[str],
        max_gap_days: int,
    ) -> Optional[RecurrencePattern]:
        """Analyze a group of events for recurrence patterns."""
        if len(events) < self.MIN_OCCURRENCES:
            return None

        # Filter out events that are too far apart
        filtered_events = self._filter_by_time_gaps(events, max_gap_days)
        if len(filtered_events) < self.MIN_OCCURRENCES:
            return None

        timestamps = [e.event_time for e in filtered_events if e.event_time]
        if len(timestamps) < 2:
            return None

        # Calculate intervals between consecutive events
        intervals = []
        for i in range(len(timestamps) - 1):
            interval = (timestamps[i + 1] - timestamps[i]).total_seconds() / 86400.0  # days
            intervals.append(interval)

        avg_interval = statistics.mean(intervals) if intervals else None
        std_dev = statistics.stdev(intervals) if len(intervals) >= 2 else None

        # Determine frequency
        frequency = self._determine_frequency(avg_interval, std_dev, len(intervals))
        trend = self._determine_trend(intervals)
        confidence = self._calculate_pattern_confidence(events, avg_interval, std_dev, frequency)

        # Gather evidence IDs
        evidence_ids = list(set(
            eid for e in events
            for eid in (e.evidence_ids or [])
        ))

        # Determine pattern type
        pattern_type = self._determine_pattern_type(events, avg_interval, std_dev)

        return RecurrencePattern(
            frequency=frequency,
            average_interval_days=avg_interval,
            interval_std_dev_days=std_dev,
            occurrences=[e.id for e in filtered_events],
            first_occurrence=timestamps[0],
            last_occurrence=timestamps[-1],
            trend=trend,
            confidence=confidence,
            pattern_type=pattern_type,
            detection_method=RecurrenceDetectionMethod.TEMPORAL_CLUSTERING,
            evidence_ids=evidence_ids,
        )

    def _filter_by_time_gaps(
        self,
        events: List[CareEvent],
        max_gap_days: int,
    ) -> List[CareEvent]:
        """Filter events to remove gaps larger than max_gap_days within a sequence."""
        if len(events) < 2:
            return events

        sorted_events = sorted(events, key=lambda e: e.event_time or datetime.min)
        result: List[CareEvent] = [sorted_events[0]]

        for i in range(1, len(sorted_events)):
            time_diff = (sorted_events[i].event_time - sorted_events[i - 1].event_time).total_seconds() / 86400.0
            if time_diff > max_gap_days:
                break
            result.append(sorted_events[i])

        return result

    def _determine_frequency(
        self,
        avg_interval: Optional[float],
        std_dev: Optional[float],
        occurrence_count: int,
    ) -> RecurrenceFrequency:
        """Determine recurrence frequency based on interval statistics."""
        if avg_interval is None:
            return RecurrenceFrequency.UNKNOWN

        cv = std_dev / avg_interval if std_dev and avg_interval > 0 else float('inf')
        is_regular = cv < 0.5 if avg_interval > 0 else False

        if avg_interval <= 1.0:  # Daily or more frequent
            if is_regular:
                return RecurrenceFrequency.DAILY
            return RecurrenceFrequency.IRREGULAR
        elif avg_interval <= 7.0:  # Weekly
            if is_regular:
                return RecurrenceFrequency.WEEKLY
            return RecurrenceFrequency.IRREGULAR
        elif avg_interval <= 14.0:  # Biweekly
            if is_regular:
                return RecurrenceFrequency.BIWEEKLY
            return RecurrenceFrequency.IRREGULAR
        elif avg_interval <= 365.0 / 12 * 1.5:  # Monthly (with tolerance)
            if is_regular:
                return RecurrenceFrequency.MONTHLY
            return RecurrenceFrequency.IRREGULAR
        elif avg_interval <= 365.0 / 4 * 1.5:  # Quarterly
            if is_regular:
                return RecurrenceFrequency.QUARTERLY
            return RecurrenceFrequency.IRREGULAR
        elif avg_interval <= 365.0 * 1.5:  # Yearly
            if is_regular:
                return RecurrenceFrequency.YEARLY
            return RecurrenceFrequency.IRREGULAR
        else:
            # Cluster analysis for episodic patterns
            if is_regular:
                return RecurrenceFrequency.CLUSTERED
            return RecurrenceFrequency.EPISODIC

    def _determine_trend(self, intervals: List[float]) -> TrendType:
        """Determine trend of recurrence intervals."""
        if len(intervals) < 2:
            return TrendType.INSUFFICIENT_DATA

        # Simple linear regression on intervals (x = index, y = interval)
        n = len(intervals)
        x_mean = (n - 1) / 2.0
        y_mean = statistics.mean(intervals)

        numerator = sum((i - x_mean) * (intervals[i] - y_mean) for i in range(n))
        denominator = sum((i - x_mean) ** 2 for i in range(n))

        if denominator == 0:
            return TrendType.STABLE

        slope = numerator / denominator

        if slope > 0.1:
            return TrendType.INCREASING  # Intervals getting longer -> less frequent
        elif slope < -0.1:
            return TrendType.DECREASING  # Intervals getting shorter -> more frequent
        elif max(intervals) - min(intervals) < y_mean * 0.2:
            return TrendType.STABLE
        else:
            return TrendType.FLUCTUATING

    def _calculate_pattern_confidence(
        self,
        events: List[CareEvent],
        avg_interval: Optional[float],
        std_dev: Optional[float],
        frequency: RecurrenceFrequency,
    ) -> float:
        """Calculate confidence in the recurrence pattern."""
        base_confidence = 0.5

        # More occurrences = higher confidence
        occurrence_count = len(events)
        base_confidence += min(0.3, (occurrence_count - 2) * 0.05)

        # Regular pattern = higher confidence
        if frequency != RecurrenceFrequency.UNKNOWN and frequency != RecurrenceFrequency.IRREGULAR:
            base_confidence += 0.2

        # Low variability = higher confidence
        if std_dev is not None and avg_interval is not None and avg_interval > 0:
            cv = std_dev / avg_interval
            if cv < 0.3:
                base_confidence += 0.15
                base_confidence = min(1.0, base_confidence)

        # Evidence quality matters
        all_evidence_active = all(
            e.lifecycle_stage != EventLifecycleStage.INVALIDATED for e in events
        )
        if all_evidence_active:
            base_confidence += 0.05

        return min(1.0, round(base_confidence, 2))

    def _determine_pattern_type(
        self,
        events: List[CareEvent],
        avg_interval: Optional[float],
        std_dev: Optional[float],
    ) -> Optional[str]:
        """Determine the pattern type (daily, weekly, monthly, irregular, etc.)."""
        if avg_interval is None:
            return None

        if std_dev and avg_interval > 0:
            cv = std_dev / avg_interval
            if cv < 0.3:
                return "regular"
            elif cv < 0.6:
                return "semi_regular"
            else:
                return "irregular"
        return "irregular"

    def create_recurrence_group(
        self,
        db: Session,
        pattern: RecurrencePattern,
        event_type: CareEventType,
        event_subtype: Optional[str],
        created_by_caregiver_id: Optional[str] = None,
    ) -> CareEventRecurrenceGroup:
        """Create a recurrence group from a detected pattern."""
        group = CareEventRecurrenceGroup(
            person_id=pattern.occurrences[0] and self._get_event_person_id(db, pattern.occurrences[0]),
            event_type=event_type,
            event_subtype=event_subtype,
            member_event_ids=pattern.occurrences,
            first_occurrence_time=pattern.first_occurrence,
            last_occurrence_time=pattern.last_occurrence,
            occurrence_count=len(pattern.occurrences),
            pattern_type=pattern.pattern_type,
            average_interval_days=pattern.average_interval_days,
            interval_std_dev_days=pattern.interval_std_dev_days,
            frequency_per_month=self._calculate_frequency_per_month(pattern),
            trend=pattern.trend.value if isinstance(pattern.trend, Enum) else str(pattern.trend),
            pattern_confidence=pattern.confidence,
            grouping_confidence=pattern.confidence,
            detection_method=pattern.detection_method,
            detection_evidence_ids=pattern.evidence_ids,
            is_active=True,
            status="active",
            created_at=datetime.now(timezone.utc),
        )

        # Update member events with group reference
        db.execute(
            "UPDATE care_event_recurrence_groups SET member_event_ids = :ids WHERE id = :id",
            {"ids": pattern.occurrences, "id": group.id} if False else None
        )

        db.add(group)
        db.commit()
        db.refresh(group)

        # Update member events
        for event_id in pattern.occurrences:
            event = db.get(CareEvent, event_id)
            if event:
                event.recurrence_group_id = group.id

        db.commit()

        return group

    def _get_event_person_id(self, db: Session, event_id: str) -> Optional[str]:
        """Get person ID for an event."""
        event = db.get(CareEvent, event_id)
        return event.person_id if event else None

    def _calculate_frequency_per_month(self, pattern: RecurrencePattern) -> Optional[float]:
        """Calculate frequency per month from pattern."""
        if pattern.average_interval_days is None or pattern.average_interval_days == 0:
            return None
        return round(30.0 / pattern.average_interval_days, 2)

    def update_recurrence_on_new_event(
        self,
        db: Session,
        person_id: str,
        new_event: CareEvent,
    ) -> Optional[RecurrencePattern]:
        """Check if a new event extends an existing recurrence pattern."""
        # Get all events of same type for this person
        existing_events = db.query(CareEvent).filter(
            CareEvent.person_id == person_id,
            CareEvent.event_type == new_event.event_type,
            CareEvent.event_subtype == new_event.event_subtype,
            CareEvent.event_time.isnot(None),
            CareEvent.id != new_event.id,
            CareEvent.lifecycle_stage != EventLifecycleStage.INVALIDATED,
        ).order_by(CareEvent.event_time.asc()).all()

        all_events = existing_events + [new_event]
        all_events.sort(key=lambda e: e.event_time or datetime.min)

        # Re-analyze pattern
        pattern = self._analyze_pattern(
            db,
            all_events,
            new_event.event_type,
            new_event.event_subtype,
            self.MAX_GAP_DAYS,
        )

        return pattern

    def get_recurrence_group(
        self,
        db: Session,
        group_id: str,
    ) -> Optional[CareEventRecurrenceGroup]:
        """Get a recurrence group by ID."""
        return db.get(CareEventRecurrenceGroup, group_id)

    def get_recurrence_groups_for_person(
        self,
        db: Session,
        person_id: str,
        event_type: Optional[CareEventType] = None,
    ) -> List[CareEventRecurrenceGroup]:
        """Get all recurrence groups for a person."""
        query = db.query(CareEventRecurrenceGroup).filter(
            CareEventRecurrenceGroup.person_id == person_id,
            CareEventRecurrenceGroup.is_active == True,
        )
        if event_type:
            type_value = event_type.value if isinstance(event_type, Enum) else event_type
            query = query.filter(CareEventRecurrenceGroup.event_type == event_type)
        return query.all()

    def delete_recurrence_group(self, db: Session, group_id: str) -> bool:
        """Delete a recurrence group (mark as inactive)."""
        group = db.get(CareEventRecurrenceGroup, group_id)
        if not group:
            return False
        group.is_active = False
        group.status = "inactive"
        db.commit()
        return True
