"""Weekly Care Review Service for SolenOS.

Implements the weekly care review workflow to help caregivers maintain
Care Memory through structured review, verification, and reconciliation
of weekly evidence against existing Care Context.
"""

from datetime import datetime, timedelta, timezone
from typing import Dict, List, Optional, Any, Tuple
from sqlalchemy.orm import Session
from sqlalchemy import and_, or_

from app.services.care_graph_service import CareGraphService
from app.services.care_graph_query import CareGraphQueryEngine
from app.models.care_graph import CareGraphNode, CareGraphEdge
from app.core.graph_enums import (
    CareGraphNodeType,
    CareGraphRelationshipType,
    CareGraphTemporalStatus,
)
from app.models.identity import Person
from app.models.evidence import Evidence
from app.models.care_event import CareEvent
from app.models.medication import Medication
from app.models.outcome import Outcome
from app.models.open_loop import OpenLoop
from app.models.care_planning import CareDecision
from app.models.caregiver import Caregiver
from app.models.time_location import Appointment
from app.models.professional_response import ProfessionalResponse


class WeeklyCareReviewService:
    """Service for generating weekly care reviews focused on Care Memory maintenance."""

    def __init__(self, db: Session):
        self.db = db
        self.care_graph_service = CareGraphService(db)
        self.query_engine = CareGraphQueryEngine(db)

    def generate_review(
        self,
        person_id: str,
        end_date: Optional[datetime] = None,
        review_start_date: Optional[datetime] = None,
    ) -> Dict[str, Any]:
        """Generate a weekly care review for a person.
        
        Args:
            person_id: The person's ID
            end_date: End of review period (defaults to now)
            review_start_date: Start of review period (defaults to 7 days before end_date)
            
        Returns:
            Dictionary containing the weekly review results focused on Care Memory maintenance
        """
        if end_date is None:
            end_date = datetime.now(timezone.utc)
        
        if review_start_date is None:
            review_start_date = end_date - timedelta(days=7)
            
        # Get evidence added/updated during the review window
        week_evidence = self._get_week_evidence(person_id, review_start_date, end_date)
        
        # Get existing Care Context as of review start (baseline)
        baseline_context = self._get_care_context_at_time(person_id, review_start_date)
        
        # Get current Care Context as of review end
        current_context = self._get_care_context_at_time(person_id, end_date)
        
        # Identify changes by comparing evidence week to baseline context
        changes_analysis = self._analyze_weekly_changes(
            week_evidence, baseline_context, current_context
        )
        
        # Identify major events from evidence
        major_events = self._identify_major_events(week_evidence)
        
        # Review unresolved issues (Open Loops)
        unresolved_issues = self._review_open_loops(person_id, review_start_date, end_date)
        
        # Review decisions made during week
        decisions_review = self._review_decisions(person_id, review_start_date, end_date)
        
        # Review outcomes that became known during week
        outcomes_review = self._review_outcomes(person_id, review_start_date, end_date)
        
        # Review medication changes
        medication_review = self._review_medications(person_id, review_start_date, end_date)
        
        # Review appointment changes
        appointments_review = self._review_appointments(person_id, review_start_date, end_date)
        
        # Review caregiver/responsibility changes
        caregiver_changes = self._review_caregiver_changes(person_id, review_start_date, end_date)
        
        # Review professional interactions
        professional_review = self._review_professional_interactions(person_id, review_start_date, end_date)
        
        # Identify conflicts
        conflicts = self._identify_conflicts(week_evidence, baseline_context)
        
        # Identify stale information
        stale_info = self._identify_stale_information(baseline_context, current_context)
        
        # Identify missing information
        missing_info = self._identify_missing_information(week_evidence, baseline_context)
        
        # Generate verification/correction opportunities
        verification_opportunities = self._generate_verification_opportunities(
            changes_analysis, unresolved_issues, conflicts, stale_info
        )
        
        # Generate new questions from evidence
        new_questions = self._generate_new_questions(week_evidence, changes_analysis)
        
        # Generate follow-up actions
        follow_up_actions = self._generate_follow_up_actions(
            unresolved_issues, decisions_review, outcomes_review, 
            medication_review, appointments_review
        )
        
        # What changed this week (concise summary)
        what_changed = self._summarize_what_changed(changes_analysis, major_events)
        
        # What matters now (current priorities)
        what_matters_now = self._determine_what_matters_now(
            unresolved_issues, medication_review, appointments_review, 
            caregiver_changes, conflicts, missing_info
        )
        
        # What remains unresolved
        what_unresolved = self._summarize_unresolved_issues(unresolved_issues, conflicts)
        
        # What follow-up is needed
        follow_up_needed = self._summarize_follow_up_needed(follow_up_actions)
        
        return {
            "person_id": person_id,
            "review_period": {
                "start_date": review_start_date.isoformat(),
                "end_date": end_date.isoformat(),
            },
            "week_evidence": {
                "total_items": len(week_evidence),
                "evidence_by_type": self._group_evidence_by_type(week_evidence),
                "date_range": {
                    "earliest": min([e.event_time for e in week_evidence if e.event_time], default=None),
                    "latest": max([e.event_time for e in week_evidence if e.event_time], default=None)
                }
            },
            "what_changed_this_week": what_changed,
            "what_matters_now": what_matters_now,
            "what_remains_unresolved": what_unresolved,
            "what_do_we_need_to_follow_up": follow_up_needed,
            "major_events": major_events,
            "changes_analysis": changes_analysis,
            "unresolved_issues": unresolved_issues,
            "decisions": decisions_review,
            "outcomes": outcomes_review,
            "medications": medication_review,
            "appointments": appointments_review,
            "caregiver_changes": caregiver_changes,
            "professional_interactions": professional_review,
            "conflicts": conflicts,
            "stale_information": stale_info,
            "missing_information": missing_info,
            "verification_opportunities": verification_opportunities,
            "new_questions": new_questions,
            "follow_up_actions": follow_up_actions,
            "care_memory_update_available": True,  # Indicates this review can update Care Memory
            "review_metadata": {
                "generated_at": datetime.now(timezone.utc).isoformat(),
                "review_type": "weekly_care_review",
                "version": "1.0"
            }
        }

    def _get_week_evidence(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> List[Evidence]:
        """Get all evidence added or meaningfully updated during the review window."""
        return self.db.query(Evidence).filter(
            Evidence.subject_id == person_id,
            or_(
                # Evidence created during the window
                and_(
                    Evidence.created_at >= start_date,
                    Evidence.created_at <= end_date
                ),
                # Evidence updated during the window (meaningful updates)
                and_(
                    Evidence.updated_at >= start_date,
                    Evidence.updated_at <= end_date,
                    Evidence.updated_at > Evidence.created_at  # Actually updated
                ),
                # Evidence with event time in window (regardless of when recorded)
                and_(
                    Evidence.event_time >= start_date,
                    Evidence.event_time <= end_date
                )
            )
        ).order_by(Evidence.event_time).all()

    def _get_care_context_at_time(
        self, 
        person_id: str, 
        target_time: datetime
    ) -> Dict[str, Any]:
        """Get the canonical Care Context (Care Graph state) at a specific point in time."""
        # Get nodes valid at target_time
        nodes = self.db.query(CareGraphNode).filter(
            CareGraphNode.person_id == person_id,
            CareGraphNode.valid_from <= target_time,
            or_(
                CareGraphNode.valid_to.is_(None),
                CareGraphNode.valid_to >= target_time
            ),
            CareGraphNode.temporal_status == CareGraphTemporalStatus.CURRENT
        ).all()
        
        # Get edges valid at target_time
        edges = self.db.query(CareGraphEdge).filter(
            CareGraphEdge.person_id == person_id,
            CareGraphEdge.valid_from <= target_time,
            or_(
                CareGraphEdge.valid_to.is_(None),
                CareGraphEdge.valid_to >= target_time
            ),
            CareGraphEdge.temporal_status == CareGraphTemporalStatus.CURRENT
        ).all()
        
        return {
            "nodes": [self._node_to_dict(node) for node in nodes],
            "edges": [self._edge_to_dict(edge) for edge in edges],
            "timestamp": target_time.isoformat(),
            "node_count": len(nodes),
            "edge_count": len(edges)
        }

    def _analyze_weekly_changes(
        self,
        week_evidence: List[Evidence],
        baseline_context: Dict[str, Any],
        current_context: Dict[str, Any]
    ) -> Dict[str, Any]:
        """Analyze what changed during the week by comparing evidence to contexts."""
        # Extract key information from week's evidence
        evidence_summary = self._summarize_evidence(week_evidence)
        
        # Compare baseline vs current context to find systemic changes
        context_changes = self._compare_contexts(baseline_context, current_context)
        
        # Identify what's new vs changed vs resolved
        analysis = {
            "evidence_summary": evidence_summary,
            "context_changes": context_changes,
            "new_information": self._identify_new_information(week_evidence, baseline_context),
            "changed_information": self._identify_changed_information(week_evidence, baseline_context, current_context),
            "resolved_information": self._identify_resolved_information(week_evidence, baseline_context),
            "novel_patterns": self._detect_novel_patterns(week_evidence),
            "change_significance": self._assess_change_significance(week_evidence, baseline_context)
        }
        
        return analysis

    def _identify_major_events(self, evidence_list: List[Evidence]) -> List[Dict[str, Any]]:
        """Identify major events from the week's evidence."""
        major_events = []
        
        for evidence in evidence_list:
            # Check if this evidence represents a major event
            if self._is_major_event(evidence):
                event_info = {
                    "evidence_id": str(evidence.id),
                    "event_type": evidence.type.value if hasattr(evidence.type, 'value') else str(evidence.type),
                    "description": evidence.normalized_text or evidence.source_text,
                    "event_time": evidence.event_time.isoformat() if evidence.event_time else None,
                    "confidence": self._get_evidence_confidence(evidence),
                    "supporting_evidence_ids": [str(eid) for eid in evidence.evidence_ids or []],
                    "provenance": {
                        "source_type": evidence.source_type.value if hasattr(evidence.source_type, 'value') else str(evidence.source_type),
                        "author_role": evidence.author_role.value if hasattr(evidence.author_role, 'value') else str(evidence.author_role),
                        "observer_role": evidence.observer_role.value if hasattr(evidence.observer_role, 'value') else str(evidence.observer_role)
                    }
                }
                major_events.append(event_info)
        
        # Deduplicate related events (e.g., hospitalization → medication change → decision)
        major_events = self._deduplicate_related_events(major_events)
        
        return major_events

    def _review_open_loops(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> Dict[str, Any]:
        """Review Open Loops/unresolved issues during the review window."""
        # Get open loops that were active during the window
        open_loops = self.db.query(OpenLoop).filter(
            OpenLoop.person_id == person_id,
            or_(
                # Loops that opened during the window
                and_(
                    OpenLoop.created_at >= start_date,
                    OpenLoop.created_at <= end_date
                ),
                # Loops that were open during the window
                and_(
                    OpenLoop.created_at <= end_date,
                    or_(
                        OpenLoop.completed_at.is_(None),
                        OpenLoop.completed_at >= start_date
                    )
                ),
                # Loops that closed during the window
                and_(
                    OpenLoop.completed_at >= start_date,
                    OpenLoop.completed_at <= end_date
                )
            )
        ).all()
        
        # Categorize by status
        loops_by_status = {
            "opened_during_week": [],
            "closed_during_week": [],
            "ongoing_from_before": [],
            "ongoing_to_after": []
        }
        
        for loop in open_loops:
            loop_dict = {
                "id": str(loop.id),
                "what_to_recheck": loop.what_to_recheck,
                "why_open": loop.why_open,
                "what_result_changes_the_plan": loop.what_result_changes_the_plan,
                "trigger": loop.trigger.value if hasattr(loop.trigger, 'value') else str(loop.trigger),
                "status": loop.status.value if hasattr(loop.status, 'value') else str(loop.status),
                "created_at": loop.created_at.isoformat() if loop.created_at else None,
                "completed_at": loop.completed_at.isoformat() if loop.completed_at else None,
                "due_at": loop.due_at.isoformat() if loop.due_at else None,
                "evidence_ids": [str(eid) for eid in loop.evidence_ids or []],
                "priority_hint": loop.priority_hint
            }
            
            # Categorize based on timing
            if loop.created_at and start_date <= loop.created_at <= end_date:
                loops_by_status["opened_during_week"].append(loop_dict)
            elif loop.completed_at and start_date <= loop.completed_at <= end_date:
                loops_by_status["closed_during_week"].append(loop_dict)
            elif (not loop.created_at or loop.created_at < start_date) and (not loop.completed_at or loop.completed_at > end_date):
                loops_by_status["ongoing_from_before"].append(loop_dict)
            elif (not loop.completed_at or loop.completed_at > end_date) and (loop.created_at and loop.created_at <= end_date):
                loops_by_status["ongoing_to_after"].append(loop_dict)
        
        return {
            "total_open_loops": len([l for l in open_loops if (l.status.value == "open" if hasattr(l.status, 'value') else l.status == "open")]),
            "loops_by_status": loops_by_status,
            "summary": {
                "newly_opened": len(loops_by_status["opened_during_week"]),
                "newly_closed": len(loops_by_status["closed_during_week"]),
                "still_open": len(loops_by_status["ongoing_from_before"]) + len(loops_by_status["ongoing_to_after"]),
                "high_priority": len([l for l in open_loops if l.priority_hint and l.priority_hint.lower() in ["high", "critical"]])
            }
        }

    def _review_decisions(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> Dict[str, Any]:
        """Review decisions made during the week."""
        decisions = self.db.query(CareDecision).filter(
            CareDecision.person_id == person_id,
            or_(
                # Decisions made during the window
                and_(
                    CareDecision.created_at >= start_date,
                    CareDecision.created_at <= end_date
                ),
                # Decisions updated during the window
                and_(
                    CareDecision.updated_at >= start_date,
                    CareDecision.updated_at <= end_date,
                    CareDecision.updated_at > CareDecision.created_at
                ),
                # Decisions decided during the window
                and_(
                    CareDecision.decided_at >= start_date,
                    CareDecision.decided_at <= end_date
                )
            )
        ).all()
        
        decision_details = []
        for decision in decisions:
            decision_dict = {
                "id": str(decision.id),
                "question": decision.question,
                "context": decision.context,
                "summary": decision.summary,
                "status": decision.status.value if hasattr(decision.status, 'value') else str(decision.status),
                "owner": decision.owner.value if hasattr(decision.owner, 'value') else str(decision.owner),
                "urgency": decision.urgency,
                "created_at": decision.created_at.isoformat() if decision.created_at else None,
                "updated_at": decision.updated_at.isoformat() if decision.updated_at else None,
                "decided_at": decision.decided_at.isoformat() if decision.decided_at else None,
                "decided_by_caregiver_id": decision.decided_by_caregiver_id,
                "evidence_ids": [str(eid) for eid in decision.evidence_ids or []],
                "options": decision.options,
                "recommendation": decision.recommendation,
                "requires_clinician": decision.requires_clinician,
                "requires_human_review": decision.requires_human_review
            }
            decision_details.append(decision_dict)
        
        return {
            "total_decisions": len(decision_details),
            "decisions": decision_details,
            "decisions_made_this_week": len([d for d in decisions if d.created_at and start_date <= d.created_at <= end_date]),
            "decisions_updated_this_week": len([d for d in decisions if d.updated_at and start_date <= d.updated_at <= end_date and d.updated_at > d.created_at]),
            "decisions_pending": len([d for d in decisions if (d.status.value in ["proposed", "under_review"] if hasattr(d.status, 'value') else d.status in ["proposed", "under_review"])]),
            "decisions_resolved": len([d for d in decisions if (d.status.value in ["accepted", "rejected"] if hasattr(d.status, 'value') else d.status in ["accepted", "rejected"])])
        }

    def _review_outcomes(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> Dict[str, Any]:
        """Review outcomes that became known during the week."""
        outcomes = self.db.query(Outcome).filter(
            Outcome.person_id == person_id,
            or_(
                # Outcomes recorded during the window
                and_(
                    Outcome.recorded_at >= start_date,
                    Outcome.recorded_at <= end_date
                ),
                # Outcomes observed during the window
                and_(
                    Outcome.observed_at >= start_date,
                    Outcome.observed_at <= end_date
                ),
                # Outcomes updated during the window
                and_(
                    Outcome.updated_at >= start_date,
                    Outcome.updated_at <= end_date,
                    Outcome.updated_at > Outcome.created_at
                )
            )
        ).all()
        
        outcome_details = []
        for outcome in outcomes:
            outcome_dict = {
                "id": str(outcome.id),
                "expectation_description": outcome.expectation_description,
                "expectation_source": outcome.expectation_source,
                "expectation_type": outcome.expectation_type.value if hasattr(outcome.expectation_type, 'value') else str(outcome.expectation_type),
                "expected_timeframe": outcome.expected_timeframe,
                "expected_by_date": outcome.expected_by_date.isoformat() if outcome.expected_by_date else None,
                "actual_outcome_description": outcome.actual_outcome_description,
                "observed_at": outcome.observed_at.isoformat() if outcome.observed_at else None,
                "recorded_at": outcome.recorded_at.isoformat() if outcome.recorded_at else None,
                "outcome_source": outcome.outcome_source,
                "reported_by_caregiver_id": outcome.reported_by_caregiver_id,
                "outcome_status": outcome.outcome_status.value if hasattr(outcome.outcome_status, 'value') else str(outcome.outcome_status),
                "comparison_result": outcome.comparison_result.value if hasattr(outcome.comparison_result, 'value') else str(outcome.comparison_result) if outcome.comparison_result else None,
                "consequence_type": outcome.consequence_type.value if hasattr(outcome.consequence_type, 'value') else str(outcome.consequence_type) if outcome.consequence_type else None,
                "consequence_description": outcome.consequence_description,
                "confidence": outcome.confidence,
                "uncertainty": outcome.uncertainty,
                "evidence_ids": [str(eid) for eid in outcome.evidence_ids or []],
                "related_entities": {
                    "decision_id": outcome.decision_id,
                    "action_id": outcome.action_id,
                    "appointment_id": outcome.appointment_id,
                    "medication_change_id": outcome.medication_change_id
                }
            }
            outcome_details.append(outcome_dict)
        
        return {
            "total_outcomes": len(outcome_details),
            "outcomes": outcome_details,
            "outcomes_known_this_week": len([o for o in outcomes if o.recorded_at and start_date <= o.recorded_at <= end_date]),
            "outcomes_observed_this_week": len([o for o in outcomes if o.observed_at and start_date <= o.observed_at <= end_date]),
            "outcomes_by_status": self._group_by_status([o.outcome_status.value if hasattr(o.outcome_status, 'value') else o.outcome_status for o in outcomes]),
            "expectation_vs_outcome_analysis": self._analyze_expectation_vs_outcome(outcomes)
        }

    def _review_medications(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> Dict[str, Any]:
        """Review medication changes and status during the week."""
        medications = self.db.query(Medication).filter(
            Medication.person_id == person_id,
            or_(
                # Medications created/documented during the window
                and_(
                    Medication.documented_date >= start_date,
                    Medication.documented_date <= end_date
                ),
                # Medications updated during the window
                and_(
                    Medication.updated_at >= start_date,
                    Medication.updated_at <= end_date,
                    Medication.updated_at > Medication.documented_date
                ),
                # Medications with effective date in window
                and_(
                    Medication.effective_date >= start_date,
                    Medication.effective_date <= end_date
                ),
                # Medication changes recorded during window
                and_(
                    Medication.change_date >= start_date,
                    Medication.change_date <= end_date
                )
            )
        ).all()
        
        # Separate by type of change
        new_medications = [m for m in medications if m.documented_date and start_date <= m.documented_date <= end_date]
        changed_medications = [m for m in medications if m.change_date and start_date <= m.change_date <= end_date]
        active_medications = [m for m in medications if m.is_active]
        
        medication_details = []
        for med in medications:
            med_dict = {
                "id": str(med.id),
                "medication_name": med.medication_name,
                "normalized_name": med.normalized_name,
                "formulation": med.formulation,
                "strength": med.strength,
                "dose_quantity": med.dose_quantity,
                "dose_unit": med.dose_unit,
                "frequency": med.frequency,
                "timing": med.timing,
                "route": med.route,
                "lifecycle_state": med.lifecycle_state,
                "is_active": med.is_active,
                "verification_status": med.verification_status,
                "verified_by_account_id": med.verified_by_account_id,
                "verified_at": med.verified_at.isoformat() if med.verified_at else None,
                "documented_date": med.documented_date.isoformat() if med.documented_date else None,
                "effective_date": med.effective_date.isoformat() if med.effective_date else None,
                "change_type": med.change_type,
                "change_description": med.change_description,
                "change_date": med.change_date.isoformat() if med.change_date else None,
                "source_type": med.source_type,
                "purpose_indication": med.purpose_indication,
                "evidence_id": str(med.evidence_id) if med.evidence_id else None,
                "open_loop_id": str(med.open_loop_id) if med.open_loop_id else None,
                "previous_version_id": str(med.previous_version_id) if med.previous_version_id else None,
                "supersedes_id": str(med.supersedes_id) if med.supersedes_id else None,
                "superseded_by_id": str(med.superseded_by_id) if med.superseded_by_id else None
            }
            medication_details.append(med_dict)
        
        return {
            "total_medications": len(medication_details),
            "medications": medication_details,
            "new_medications_this_week": len(new_medications),
            "changed_medications_this_week": len(changed_medications),
            "active_medications_count": len(active_medications),
            "verification_status_summary": self._group_by_status([m.verification_status.value if hasattr(m.verification_status, 'value') else m.verification_status for m in medications]),
            "lifecycle_state_summary": self._group_by_status([m.lifecycle_state.value if hasattr(m.lifecycle_state, 'value') else m.lifecycle_state for m in medications]),
            "medication_changes_requiring_verification": len([m for m in medications if (m.verification_status in ["UNVERIFIED", "CONFLICTING"] if hasattr(m.verification_status, 'value') else m.verification_status in ["UNVERIFIED", "CONFLICTING"])])
        }

    def _review_appointments(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> Dict[str, Any]:
        """Review appointment changes and status during the week."""
        appointments = self.db.query(Appointment).filter(
            Appointment.person_id == person_id,
            or_(
                # Appointments created/scheduled during window
                and_(
                    Appointment.created_at >= start_date,
                    Appointment.created_at <= end_date
                ),
                # Appointments updated during window
                and_(
                    Appointment.updated_at >= start_date,
                    Appointment.updated_at <= end_date,
                    Appointment.updated_at > Appointment.created_at
                ),
                # Appointments occurring during window
                and_(
                    Appointment.start_time >= start_date,
                    Appointment.start_time <= end_date
                ),
                # Appointments completed during window
                and_(
                    Appointment.completed_at >= start_date,
                    Appointment.completed_at <= end_date
                )
            )
        ).all()
        
        appointment_details = []
        for apt in appointments:
            apt_dict = {
                "id": str(apt.id),
                "title": apt.title,
                "description": apt.description,
                "appointment_type": apt.appointment_type,
                "start_time": apt.start_time.isoformat() if apt.start_time else None,
                "end_time": apt.end_time.isoformat() if apt.end_time else None,
                "location": apt.location,
                "status": apt.status.value if hasattr(apt.status, 'value') else str(apt.status),
                "priority": apt.priority,
                "created_at": apt.created_at.isoformat() if apt.created_at else None,
                "updated_at": apt.updated_at.isoformat() if apt.updated_at else None,
                "completed_at": apt.completed_at.isoformat() if apt.completed_at else None,
                "cancelled_at": apt.cancelled_at.isoformat() if apt.cancelled_at else None,
                "reminder_sent": apt.reminder_sent,
                "participant_ids": apt.participant_ids,
                "provider_id": apt.provider_id,
                "caregiver_id": apt.caregiver_id,
                "evidence_ids": [str(eid) for eid in apt.evidence_ids or []],
                "related_entities": {
                    "decision_id": apt.decision_id,
                    "outcome_id": apt.outcome_id,
                    "medication_id": apt.medication_id
                }
            }
            appointment_details.append(apt_dict)
        
        # Categorize appointments
        scheduled_this_week = [a for a in appointments if a.start_time and start_date <= a.start_time <= end_date]
        completed_this_week = [a for a in appointments if a.completed_at and start_date <= a.completed_at <= end_date]
        cancelled_this_week = [a for a in appointments if a.cancelled_at and start_date <= a.cancelled_at <= end_date]
        upcoming = [a for a in appointments if a.start_time and a.start_time > end_date]
        
        return {
            "total_appointments": len(appointment_details),
            "appointments": appointment_details,
            "scheduled_this_week": len(scheduled_this_week),
            "completed_this_week": len(completed_this_week),
            "cancelled_this_week": len(cancelled_this_week),
            "upcoming_appointments": len(upcoming),
            "status_summary": self._group_by_status([a.status for a in appointments]),
            "appointments_needing_preparation": len([a for a in upcoming if (a.status.value == "scheduled" if hasattr(a.status, 'value') else a.status == "scheduled")]),
        }

    def _review_caregiver_changes(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> Dict[str, Any]:
        """Review caregiver and responsibility changes during the week."""
        # Get caregiver role links that changed during the window
        caregiver_changes = self.db.query(Caregiver).filter(
            Caregiver.person_id == person_id,
            or_(
                # Caregivers added during window
                and_(
                    Caregiver.created_at >= start_date,
                    Caregiver.created_at <= end_date
                ),
                # Caregivers updated during window
                and_(
                    Caregiver.updated_at >= start_date,
                    Caregiver.updated_at <= end_date,
                    Caregiver.updated_at > Caregiver.created_at
                ),
                # Caregivers removed during window (soft delete or status change)
                and_(
                    Caregiver.updated_at >= start_date,
                    Caregiver.updated_at <= end_date,
                    Caregiver.is_active == False  # Assuming inactive means removed
                )
            )
        ).all()
        
        caregiver_details = []
        for caregiver in caregiver_changes:
            caregiver_dict = {
                "id": str(caregiver.id),
                "caregiver_role": caregiver.role.value if hasattr(caregiver.role, 'value') else str(caregiver.role),
                "is_active": caregiver.is_active,
                "created_at": caregiver.created_at.isoformat() if caregiver.created_at else None,
                "updated_at": caregiver.updated_at.isoformat() if caregiver.updated_at else None,
                "invited_by_account_id": caregiver.invited_by_account_id,
                "invited_at": caregiver.invited_at.isoformat() if caregiver.invited_at else None,
                "accepted_at": caregiver.accepted_at.isoformat() if caregiver.accepted_at else None,
                "relationship_to_person": caregiver.relationship_to_person
            }
            caregiver_details.append(caregiver_dict)
        
        # Get responsibility changes if tracked separately
        responsibility_changes = []  # Would come from responsibility tracking if implemented
        
        return {
            "total_caregivers": len(caregiver_details),
            "caregivers": caregiver_details,
            "caregivers_added_this_week": len([c for c in caregiver_changes if c.created_at and start_date <= c.created_at <= end_date and c.is_active]),
            "caregivers_removed_this_week": len([c for c in caregiver_changes if c.updated_at and start_date <= c.updated_at <= end_date and not c.is_active]),
            "caregivers_updated_this_week": len([c for c in caregiver_changes if c.updated_at and start_date <= c.updated_at <= end_date and c.updated_at > c.created_at]),
            "responsibility_changes": responsibility_changes,
            "current_active_caregivers": len([c for c in caregiver_changes if c.is_active])
        }

    def _review_professional_interactions(
        self, 
        person_id: str, 
        start_date: datetime, 
        end_date: datetime
    ) -> Dict[str, Any]:
        """Review professional interactions during the week."""
        # Get professional responses/interactions during the window
        professional_responses = self.db.query(ProfessionalResponse).filter(
            ProfessionalResponse.person_id == person_id,
            or_(
                # Responses created during window
                and_(
                    ProfessionalResponse.created_at >= start_date,
                    ProfessionalResponse.created_at <= end_date
                ),
                # Responses updated during window
                and_(
                    ProfessionalResponse.updated_at >= start_date,
                    ProfessionalResponse.updated_at <= end_date,
                    ProfessionalResponse.updated_at > ProfessionalResponse.created_at
                ),
                # Responses with interaction date in window
                and_(
                    ProfessionalResponse.interaction_date >= start_date,
                    ProfessionalResponse.interaction_date <= end_date
                )
            )
        ).all()
        
        response_details = []
        for resp in professional_responses:
            resp_dict = {
                "id": str(resp.id),
                "response_type": resp.response_type,
                "summary": resp.summary,
                "professional_role": resp.professional_role.value if hasattr(resp.professional_role, 'value') else str(resp.professional_role),
                "professional_name": resp.professional_name,
                "interaction_date": resp.interaction_date.isoformat() if resp.interaction_date else None,
                "created_at": resp.created_at.isoformat() if resp.created_at else None,
                "updated_at": resp.updated_at.isoformat() if resp.updated_at else None,
                "evidence_ids": [str(eid) for eid in resp.evidence_ids or []],
                "recommendations": resp.recommendations,
                "decisions_made": resp.decisions_made,
                "follow_up_required": resp.follow_up_required,
                "follow_up_details": resp.follow_up_details,
                "outcome_related": resp.outcome_related,
                "questions_answered": resp.questions_answered,
                "questions_remaining": resp.questions_remaining,
                "confidence": resp.confidence,
                "uncertainty": resp.uncertainty
            }
            response_details.append(resp_dict)
        
        return {
            "total_interactions": len(response_details),
            "professional_responses": response_details,
            "interactions_this_week": len([r for r in professional_responses if r.created_at and start_date <= r.created_at <= end_date]),
            "interactions_by_type": self._group_by_type([r.response_type for r in professional_responses]),
            "follow_up_required_count": len([r for r in professional_responses if r.follow_up_required]),
            "questions_answered_total": sum([len(r.questions_answered or []) for r in professional_responses]),
            "questions_remaining_total": sum([len(r.questions_remaining or []) for r in professional_responses])
        }

    def _identify_conflicts(
        self, 
        week_evidence: List[Evidence], 
        baseline_context: Dict[str, Any]
    ) -> List[Dict[str, Any]]:
        """Identify conflicting information in the week's evidence."""
        conflicts = []
        
        # Group evidence by subject and type to find potential conflicts
        evidence_by_subject_type = {}
        for evidence in week_evidence:
            key = (evidence.subject_id, evidence.type)
            if key not in evidence_by_subject_type:
                evidence_by_subject_type[key] = []
            evidence_by_subject_type[key].append(evidence)
        
        # Check for conflicts within each group
        for (subject_id, evidence_type), evidences in evidence_by_subject_type.items():
            if len(evidences) > 1:
                # Look for contradictory normalized text or values
                conflict_groups = self._find_contradictory_evidence(evidences)
                for conflict_group in conflict_groups:
                    if len(conflict_group) > 1:  # Actual conflict found
                        conflict_info = {
                            "subject_id": str(subject_id),
                            "evidence_type": evidence_type.value if hasattr(evidence_type, 'value') else str(evidence_type),
                            "conflicting_evidence": [
                                {
                                    "evidence_id": str(e.id),
                                    "source_text": e.source_text,
                                    "normalized_text": e.normalized_text,
                                    "event_time": e.event_time.isoformat() if e.event_time else None,
                                    "created_at": e.created_at.isoformat() if e.created_at else None,
                                    "confidence": self._get_evidence_confidence(e)
                                }
                                for e in conflict_group
                            ],
                            "conflict_type": self._determine_conflict_type(conflict_group),
                            "resolution_status": "unresolved",  # Would be updated based on verification
                            "evidence_dates": [e.event_time.isoformat() if e.event_time else e.created_at.isoformat() for e in conflict_group if e.event_time or e.created_at]
                        }
                        conflicts.append(conflict_info)
        
        return conflicts

    def _identify_stale_information(
        self, 
        baseline_context: Dict[str, Any], 
        current_context: Dict[str, Any]
    ) -> List[Dict[str, Any]]:
        """Identify information that may have become stale."""
        stale_items = []
        
        baseline_nodes = {n["id"]: n for n in baseline_context["nodes"]}
        current_nodes = {n["id"]: n for n in current_context["nodes"]}
        
        # Check for nodes that existed in baseline but may be stale in current
        for node_id, baseline_node in baseline_nodes.items():
            if node_id in current_nodes:
                current_node = current_nodes[node_id]
                # Check if the node hasn't been updated recently but might be outdated
                baseline_updated = baseline_node.get("updated_at")
                current_updated = current_node.get("updated_at")
                
                # If not updated in the review period but existed before, flag for review
                if baseline_updated and not current_updated:
                    # Node existed in baseline but no update info in current - potentially stale
                    stale_items.append({
                        "type": "node",
                        "id": node_id,
                        "label": baseline_node.get("label"),
                        "node_type": baseline_node.get("type"),
                        "last_known_baseline_update": baseline_updated,
                        "current_status": "potentially_stale",
                        "reason": "No update timestamp in current context",
                        "baseline_properties": baseline_node.get("properties", {}),
                        "current_properties": current_node.get("properties", {})
                    })
                elif baseline_updated and current_updated and baseline_updated == current_updated:
                    # Same update timestamp - check if significant time has passed
                    # This would need more sophisticated staleness detection
                    pass
        
        # Similar check for edges
        baseline_edges = {e["id"]: e for e in baseline_context["edges"]}
        current_edges = {e["id"]: e for e in current_context["edges"]}
        
        for edge_id, baseline_edge in baseline_edges.items():
            if edge_id in current_edges:
                current_edge = current_edges[edge_id]
                baseline_updated = baseline_edge.get("updated_at")
                current_updated = current_edge.get("updated_at")
                
                if baseline_updated and not current_updated:
                    stale_items.append({
                        "type": "edge",
                        "id": edge_id,
                        "source_node_id": baseline_edge.get("source_node_id"),
                        "target_node_id": baseline_edge.get("target_node_id"),
                        "relationship_type": baseline_edge.get("type"),
                        "last_known_baseline_update": baseline_updated,
                        "current_status": "potentially_stale",
                        "reason": "No update timestamp in current context",
                        "baseline_properties": baseline_edge.get("properties", {}),
                        "current_properties": current_edge.get("properties", {})
                    })
        
        return stale_items

    def _identify_missing_information(
        self, 
        week_evidence: List[Evidence], 
        baseline_context: Dict[str, Any]
    ) -> List[Dict[str, Any]]:
        """Identify important information gaps."""
        missing_info = []
        
        # Check for common expected information types that are missing
        expected_evidence_types = [
            "medication", "appointment", "professional_interaction", 
            "symptom_observation", "vital_signs", "lab_result"
        ]
        
        week_evidence_types = set([e.type.value if hasattr(e.type, 'value') else str(e.type) for e in week_evidence])
        
        for expected_type in expected_evidence_types:
            if expected_type not in week_evidence_types:
                # Check if this type was present in baseline (meaning we expect it to continue)
                baseline_types = set([n.get("type") for n in baseline_context["nodes"]] + 
                                   [e.get("type") for e in baseline_context["edges"]])
                
                if expected_type in baseline_types:
                    missing_info.append({
                        "type": "missing_evidence_type",
                        "expected_type": expected_type,
                        "reason": "Expected evidence type not found during review week",
                        "baseline_present": True,
                        "suggested_action": f"Consider checking for {expected_type} updates"
                    })
        
        # Check for missing critical fields in evidence
        for evidence in week_evidence:
            missing_fields = []
            if not evidence.event_time:
                missing_fields.append("event_time")
            if not evidence.normalized_text and not evidence.source_text:
                missing_fields.append("content")
            if evidence.confidence is None or evidence.confidence < 0.5:
                missing_fields.append("sufficient_confidence")
            
            if missing_fields:
                missing_info.append({
                    "type": "incomplete_evidence",
                    "evidence_id": str(evidence.id),
                    "missing_fields": missing_fields,
                    "evidence_type": evidence.type.value if hasattr(evidence.type, 'value') else str(evidence.type),
                    "suggested_action": f"Complete missing fields: {', '.join(missing_fields)}"
                })
        
        return missing_info

    def _generate_verification_opportunities(
        self,
        changes_analysis: Dict[str, Any],
        unresolved_issues: Dict[str, Any],
        conflicts: List[Dict[str, Any]],
        stale_info: List[Dict[str, Any]]
    ) -> List[Dict[str, Any]]:
        """Generate specific verification/correction opportunities."""
        opportunities = []
        
        # From conflicts
        for conflict in conflicts:
            opportunities.append({
                "type": "resolve_conflict",
                "description": f"Resolve conflicting information about {conflict['subject_id']}",
                "conflict_id": str(id(conflict)),  # Temporary ID
                "evidence_count": len(conflict["conflicting_evidence"]),
                "suggested_action": "Verify which information is correct with authoritative source",
                "priority": "high" if len(conflict["conflicting_evidence"]) > 2 else "medium",
                "related_evidence": conflict["conflicting_evidence"]
            })
        
        # From stale information
        for stale in stale_info:
            opportunities.append({
                "type": "verify_currency",
                "description": f"Verify if {stale.get('label', stale.get('id'))} is still current",
                "item_id": stale["id"],
                "item_type": stale["type"],
                "suggested_action": "Check with primary caregiver or authoritative source",
                "priority": "medium",
                "baseline_info": stale.get("baseline_properties"),
                "current_info": stale.get("current_properties")
            })
        
        # From unresolved issues with high priority
        high_priority_loops = unresolved_issues.get("loops_by_status", {}).get("opened_during_week", []) + \
                             unresolved_issues.get("loops_by_status", {}).get("ongoing_from_before", [])
        high_priority = [l for l in high_priority_loops if l.get("priority_hint", "").lower() in ["high", "critical"]]
        
        for loop in high_priority[:5]:  # Limit to top 5
            opportunities.append({
                "type": "address_open_loop",
                "description": loop["what_to_recheck"],
                "loop_id": loop["id"],
                "why_open": loop["why_open"],
                "suggested_action": f"Investigate: {loop['what_result_changes_the_plan']}",
                "priority": "high",
                "due_date": loop.get("due_at"),
                "evidence_ids": loop.get("evidence_ids", [])
            })
        
        # From significant changes needing verification
        significant_changes = changes_analysis.get("change_significance", {}).get("high_significance_changes", [])
        for change in significant_changes[:3]:  # Limit to top 3
            opportunities.append({
                "type": "verify_change",
                "description": f"Verify significant change: {change.get('description', 'Unknown change')}",
                "change_id": str(id(change)),  # Temporary ID
                "suggested_action": "Confirm with primary source or professional",
                "priority": "medium",
                "change_details": change
            })
        
        return opportunities

    def _generate_new_questions(
        self, 
        week_evidence: List[Evidence], 
        changes_analysis: Dict[str, Any]
    ) -> List[Dict[str, Any]]:
        """Generate new evidence-backed questions from the week's review."""
        questions = []
        
        # Questions from unresolved patterns in evidence
        novel_patterns = changes_analysis.get("novel_patterns", [])
        for pattern in novel_patterns[:3]:
            questions.append({
                "type": "pattern_investigation",
                "question": f"What is the significance of the observed pattern in {pattern.get('field', 'observations')}?",
                "pattern_description": pattern.get("description"),
                "supporting_evidence_count": pattern.get("evidence_count", 0),
                "priority": "medium",
                "suggested_investigation": "Track over next week and consult with professional if pattern continues"
            })
        
        # Questions from changes needing explanation
        changed_info = changes_analysis.get("changed_information", [])
        for change in changed_info[:3]:
            if change.get("significance") == "high":
                questions.append({
                    "type": "change_explanation",
                    "question": f"Why did {change.get('field', 'this information')} change?",
                    "change_description": change.get("description"),
                    "before_value": change.get("before_value"),
                    "after_value": change.get("after_value"),
                    "priority": "high",
                    "suggested_investigation": "Review events around time of change and consult involved parties"
                })
        
        # Questions from evidence gaps
        missing_info = changes_analysis.get("evidence_summary", {}).get("missing_critical_types", [])
        for missing_type in missing_info[:2]:
            questions.append({
                "type": "information_gap",
                "question": f"What is the current status of {missing_type}?",
                "missing_type": missing_type,
                "priority": "medium",
                "suggested_investigation": f"Check for recent {missing_type} evidence or request updates"
            })
        
        # Questions from novel information
        new_info = changes_analysis.get("new_information", [])
        for info in new_info[:2]:
            questions.append({
                "type": "novel_information_followup",
                "question": f"What does the new information about {info.get('field', 'this topic')} mean for care?",
                "information_description": info.get("description"),
                "evidence_count": info.get("evidence_count", 0),
                "priority": "low",
                "suggested_investigation": "Monitor for additional evidence and consult with care team"
            })
        
        return questions

    def _generate_follow_up_actions(
        self,
        unresolved_issues: Dict[str, Any],
        decisions_review: Dict[str, Any],
        outcomes_review: Dict[str, Any],
        medication_review: Dict[str, Any],
        appointments_review: Dict[str, Any]
    ) -> List[Dict[str, Any]]:
        """Generate information-reducing follow-up actions."""
        actions = []
        
        # From unresolved issues
        open_loops = unresolved_issues.get("loops_by_status", {})
        for loop_list_key in ["opened_during_week", "ongoing_from_before", "ongoing_to_after"]:
            for loop in open_loops.get(loop_list_key, []):
                if loop.get("what_result_changes_the_plan"):
                    actions.append({
                        "type": "address_open_loop",
                        "description": loop["what_to_recheck"],
                        "loop_id": loop["id"],
                        "uncertainty_reduced": "Will clarify what result changes the care plan",
                        "suggested_action": loop["what_result_changes_the_plan"],
                        "priority": "high" if loop.get("priority_hint", "").lower() in ["high", "critical"] else "medium",
                        "due_date": loop.get("due_at"),
                        "evidence_ids": loop.get("evidence_ids", [])
                    })
        
        # From decisions needing outcome evaluation
        pending_decisions = decisions_review.get("decisions_pending", 0)
        if pending_decisions > 0:
            actions.append({
                "type": "evaluate_decision_outcomes",
                "description": f"Evaluate outcomes of {pending_decisions} pending decisions",
                "uncertainty_reduced": "Will determine if decisions were effective",
                "suggested_action": "Monitor for outcome evidence and consult with care team",
                "priority": "medium",
                "decision_count": pending_decisions
            })
        
        # From medication changes needing verification
        meds_needing_verification = medication_review.get("medication_changes_requiring_verification", 0)
        if meds_needing_verification > 0:
            actions.append({
                "type": "verify_medication_changes",
                "description": f"Verify {meds_needing_verification} medication changes requiring confirmation",
                "uncertainty_reduced": "Will establish current accurate medication instructions",
                "suggested_action": "Confirm with prescribing physician or pharmacist",
                "priority": "high",
                "medication_count": meds_needing_verification
            })
        
        # From upcoming appointments needing preparation
        upcoming_appointments = appointments_review.get("upcoming_appointments", 0)
        prep_needed = appointments_review.get("appointments_needing_preparation", 0)
        if prep_needed > 0:
            actions.append({
                "type": "prepare_for_appointments",
                "description": f"Prepare for {prep_needed} upcoming appointments",
                "uncertainty_reduced": "Will ensure productive and informed appointments",
                "suggested_action": "Gather relevant evidence, questions, and updates for discussion",
                "priority": "medium",
                "appointment_count": prep_needed,
                "timeframe": "Before upcoming appointments"
            })
        
        # From outcomes needing follow-up
        unresolved_outcomes = outcomes_review.get("outcomes_by_status", {}).get("unknown", 0) + \
                            outcomes_review.get("outcomes_by_status", {}).get("uncertain", 0)
        if unresolved_outcomes > 0:
            actions.append({
                "type": "investigate_unresolved_outcomes",
                "description": f"Investigate {unresolved_outcomes} unresolved or uncertain outcomes",
                "uncertainty_reduced": "Will establish whether expected outcomes were achieved",
                "suggested_action": "Gather additional evidence and consult with professionals",
                "priority": "medium",
                "outcome_count": unresolved_outcomes
            })
        
        return actions

    # Helper methods
    def _node_to_dict(self, node: CareGraphNode) -> Dict[str, Any]:
        """Convert a node to a dictionary representation."""
        return {
            "id": str(node.id),
            "type": node.node_type.value if hasattr(node.node_type, 'value') else str(node.node_type),
            "label": node.label,
            "canonical_entity_id": node.canonical_entity_id,
            "canonical_entity_type": node.canonical_entity_type,
            "properties": node.properties or {},
            "provenance": {
                "source": node.provenance_source.value if hasattr(node.provenance_source, 'value') else str(node.provenance_source),
                "details": node.provenance_details or {},
            },
            "valid_from": node.valid_from.isoformat() if node.valid_from else None,
            "valid_to": node.valid_to.isoformat() if node.valid_to else None,
            "updated_at": node.updated_at.isoformat() if node.updated_at else None,
            "created_at": node.created_at.isoformat() if node.created_at else None
        }

    def _edge_to_dict(self, edge: CareGraphEdge) -> Dict[str, Any]:
        """Convert an edge to a dictionary representation."""
        return {
            "id": str(edge.id),
            "source_node_id": str(edge.source_node_id),
            "target_node_id": str(edge.target_node_id),
            "type": edge.relationship_type.value if hasattr(edge.relationship_type, 'value') else str(edge.relationship_type),
            "subtype": edge.relationship_subtype.value if hasattr(edge.relationship_subtype, 'value') else str(edge.relationship_subtype),
            "status": edge.status.value if hasattr(edge.status, 'value') else str(edge.status),
            "properties": edge.properties or {},
            "provenance": {
                "source": edge.provenance_source.value if hasattr(edge.provenance_source, 'value') else str(edge.provenance_source),
                "details": edge.provenance_details or {},
            },
            "valid_from": edge.valid_from.isoformat() if edge.valid_from else None,
            "valid_to": edge.valid_to.isoformat() if edge.valid_to else None,
            "updated_at": edge.updated_at.isoformat() if edge.updated_at else None,
            "created_at": edge.created_at.isoformat() if edge.created_at else None
        }

    def _summarize_evidence(self, evidence_list: List[Evidence]) -> Dict[str, Any]:
        """Create a summary of the evidence list."""
        if not evidence_list:
            return {"total": 0, "by_type": {}, "date_range": None}
        
        # Group by type
        by_type = {}
        for evidence in evidence_list:
            evidence_type = evidence.type.value if hasattr(evidence.type, 'value') else str(evidence.type)
            by_type[evidence_type] = by_type.get(evidence_type, 0) + 1
        
        # Date range
        event_times = [e.event_time for e in evidence_list if e.event_time]
        created_times = [e.created_at for e in evidence_list if e.created_at]
        all_times = event_times + created_times
        
        date_range = None
        if all_times:
            date_range = {
                "earliest": min(all_times).isoformat(),
                "latest": max(all_times).isoformat()
            }
        
        return {
            "total": len(evidence_list),
            "by_type": by_type,
            "date_range": date_range,
            "with_event_time": len(event_times),
            "recently_created": len([e for e in evidence_list if e.created_at and 
                                   (datetime.now(timezone.utc) - e.created_at).days <= 7])
        }

    def _group_evidence_by_type(self, evidence_list: List[Evidence]) -> Dict[str, int]:
        """Group evidence by type and return counts."""
        type_counts = {}
        for evidence in evidence_list:
            evidence_type = evidence.type.value if hasattr(evidence.type, 'value') else str(evidence.type)
            type_counts[evidence_type] = type_counts.get(evidence_type, 0) + 1
        return type_counts

    def _is_major_event(self, evidence: Evidence) -> bool:
        """Determine if evidence represents a major event."""
        major_event_types = [
            "hospitalization", "appointment", "professional_interaction", 
            "medication_change", "care_decision", "significant_symptom_change",
            "responsibility_change", "caregiver_change"
        ]
        
        evidence_type = evidence.type.value if hasattr(evidence.type, 'value') else str(evidence.type)
        return evidence_type in major_event_types

    def _get_evidence_confidence(self, evidence: Evidence) -> float:
        """Get overall confidence score from evidence."""
        # Use the multi-dimensional confidence if available, otherwise fall back to simple confidence
        if evidence.confidence_overall is not None:
            return evidence.confidence_overall
        elif evidence.confidence is not None:
            return evidence.confidence
        else:
            # Calculate from available dimensions if possible
            dims = [evidence.confidence_extraction, evidence.confidence_entity_resolution, 
                   evidence.confidence_temporal, evidence.confidence_source_support, 
                   evidence.confidence_interpretation]
            valid_dims = [d for d in dims if d is not None]
            return sum(valid_dims) / len(valid_dims) if valid_dims else 0.5

    def _compare_contexts(
        self, 
        baseline: Dict[str, Any], 
        current: Dict[str, Any]
    ) -> Dict[str, Any]:
        """Compare two care contexts to identify changes."""
        baseline_nodes = {n["id"]: n for n in baseline["nodes"]}
        current_nodes = {n["id"]: n for n in current["nodes"]}
        baseline_edges = {e["id"]: e for e in baseline["edges"]}
        current_edges = {e["id"]: e for e in current["edges"]}
        
        # Nodes
        added_nodes = [n for nid, n in current_nodes.items() if nid not in baseline_nodes]
        removed_nodes = [n for nid, n in baseline_nodes.items() if nid not in current_nodes]
        changed_nodes = []
        for nid in set(baseline_nodes.keys()) & set(current_nodes.keys()):
            if self._nodes_differ(baseline_nodes[nid], current_nodes[nid]):
                changed_nodes.append({"before": baseline_nodes[nid], "after": current_nodes[nid]})
        
        # Edges
        added_edges = [e for eid, e in current_edges.items() if eid not in baseline_edges]
        removed_edges = [e for eid, e in baseline_edges.items() if eid not in current_edges]
        changed_edges = []
        for eid in set(baseline_edges.keys()) & set(current_edges.keys()):
            if self._edges_differ(baseline_edges[eid], current_edges[eid]):
                changed_edges.append({"before": baseline_edges[eid], "after": current_edges[eid]})
        
        return {
            "nodes": {
                "added": added_nodes,
                "removed": removed_nodes,
                "changed": changed_nodes,
                "added_count": len(added_nodes),
                "removed_count": len(removed_nodes),
                "changed_count": len(changed_nodes)
            },
            "edges": {
                "added": added_edges,
                "removed": removed_edges,
                "changed": changed_edges,
                "added_count": len(added_edges),
                "removed_count": len(removed_edges),
                "changed_count": len(changed_edges)
            }
        }

    def _nodes_differ(self, node1: Dict[str, Any], node2: Dict[str, Any]) -> bool:
        """Check if two nodes have meaningful differences."""
        if node1.get("label") != node2.get("label"):
            return True
        if node1.get("canonical_entity_id") != node2.get("canonical_entity_id"):
            return True
        if node1.get("canonical_entity_type") != node2.get("canonical_entity_type"):
            return True
        # Compare properties
        props1 = node1.get("properties", {})
        props2 = node2.get("properties", {})
        if props1 != props2:
            return True
        return False

    def _edges_differ(self, edge1: Dict[str, Any], edge2: Dict[str, Any]) -> bool:
        """Check if two edges have meaningful differences."""
        if edge1.get("status") != edge2.get("status"):
            return True
        if edge1.get("subtype") != edge2.get("subtype"):
            return True
        # Compare properties
        props1 = edge1.get("properties", {})
        props2 = edge2.get("properties", {})
        if props1 != props2:
            return True
        return False

    def _identify_new_information(
        self, 
        week_evidence: List[Evidence], 
        baseline_context: Dict[str, Any]
    ) -> List[Dict[str, Any]]:
        """Identify information that is genuinely new (not in baseline)."""
        # Simplified - would need more sophisticated comparison
        baseline_node_ids = {n["id"] for n in baseline_context["nodes"]}
        baseline_edge_ids = {e["id"] for e in baseline_context["edges"]}
        
        new_info = []
        for evidence in week_evidence:
            # Check if this evidence represents information not in baseline
            # This is a simplified check - real implementation would be more sophisticated
            if evidence.subject_id not in baseline_node_ids:  # New subject
                new_info.append({
                    "type": "new_subject",
                    "evidence_id": str(evidence.id),
                    "subject_id": str(evidence.subject_id),
                    "description": evidence.normalized_text or evidence.source_text,
                    "event_time": evidence.event_time.isoformat() if evidence.event_time else None,
                    "confidence": self._get_evidence_confidence(evidence)
                })
        
        return new_info

