    def _summarize_what_changed(
        self, 
        changes_analysis: Dict[str, Any], 
        major_events: List[Dict[str, Any]]
    ) -> str:
        """Create a concise summary of what changed this week."""
        evidence_summary = changes_analysis.get("evidence_summary", {})
        total_evidence = evidence_summary.get("total", 0)
        
        context_changes = changes_analysis.get("context_changes", {})
        nodes_changed = context_changes.get("nodes", {}).get("changed_count", 0)
        edges_changed = context_changes.get("edges", {}).get("changed_count", 0)
        
        if total_evidence == 0 and nodes_changed == 0 and edges_changed == 0:
            return "No significant changes detected in care context this week."
        
        parts = []
        if total_evidence > 0:
            parts.append(f"{total_evidence} pieces of new evidence recorded")
        if nodes_changed > 0:
            parts.append(f"{nodes_changed} care context elements modified")
        if edges_changed > 0:
            parts.append(f"{edges_changed} relationships updated")
        if len(major_events) > 0:
            parts.append(f"{len(major_events)} major events identified")
        
        return ", ".join(parts) + "."

    def _determine_what_matters_now(
        self,
        unresolved_issues: Dict[str, Any],
        medication_review: Dict[str, Any],
        appointments_review: Dict[str, Any],
        caregiver_changes: Dict[str, Any],
        conflicts: List[Dict[str, Any]],
        missing_info: List[Dict[str, Any]]
    ) -> List[str]:
        """Determine what matters most for care continuity now."""
        matters = []
        
        # High priority unresolved issues
        high_priority_count = unresolved_issues.get("summary", {}).get("high_priority", 0)
        if high_priority_count > 0:
            matters.append(f"{high_priority_count} high-priority unresolved issues requiring attention")
        
        # Medication safety
        meds_needing_verification = medication_review.get("medication_changes_requiring_verification", 0)
        if meds_needing_verification > 0:
            matters.append(f"{meds_needing_verification} medication changes requiring verification for safety")
        
        # Upcoming appointments
        upcoming = appointments_review.get("upcoming_appointments", 0)
        if upcoming > 0:
            matters.append(f"{upcoming} upcoming appointments requiring preparation")
        
        # Critical conflicts
        critical_conflicts = [c for c in conflicts if len(c.get("conflicting_evidence", [])) > 2]
        if critical_conflicts:
            matters.append(f"{len(critical_conflicts)} critical information conflicts needing resolution")
        
        # Caregiver changes
        caregivers_added = caregiver_changes.get("caregivers_added_this_week", 0)
        caregivers_removed = caregiver_changes.get("caregivers_removed_this_week", 0)
        if caregivers_added > 0 or caregivers_removed > 0:
            matters.append(f"Caregiver team changed: {caregivers_added} added, {caregivers_removed} removed")
        
        # Missing critical information
        critical_missing = [m for m in missing_info if m.get("type") == "missing_evidence_type" and m.get("baseline_present")]
        if critical_missing:
            matters.append(f"{len(critical_missing)} expected information types missing this week")
        
        # If nothing critical, show general matters
        if not matters:
            matters.append("Care context appears stable - continue routine monitoring")
        
        return matters[:5]  # Limit to top 5

    def _summarize_unresolved_issues(
        self, 
        unresolved_issues: Dict[str, Any], 
        conflicts: List[Dict[str, Any]]
    ) -> str:
        """Summarize what remains unresolved."""
        total_open = unresolved_issues.get("summary", {}).get("still_open", 0)
        newly_opened = unresolved_issues.get("summary", {}).get("newly_opened", 0)
        conflict_count = len(conflicts)
        
        if total_open == 0 and conflict_count == 0:
            return "No unresolved issues or conflicts identified."
        
        parts = []
        if total_open > 0:
            parts.append(f"{total_open} unresolved issues remain open ({newly_opened} newly identified this week)")
        if conflict_count > 0:
            parts.append(f"{conflict_count} information conflicts require resolution")
        
        return ". ".join(parts) + "."

    def _summarize_follow_up_needed(self, follow_up_actions: List[Dict[str, Any]]) -> str:
        """Summarize what follow-up is needed."""
        if not follow_up_actions:
            return "No specific follow-up actions identified at this time."
        
        # Count by priority
        high_priority = len([a for a in follow_up_actions if a.get("priority") == "high"])
        medium_priority = len([a for a in follow_up_actions if a.get("priority") == "medium"])
        low_priority = len([a for a in follow_up_actions if a.get("priority") == "low"])
        
        parts = []
        if high_priority > 0:
            parts.append(f"{high_priority} high-priority actions")
        if medium_priority > 0:
            parts.append(f"{medium_priority} medium-priority actions")
        if low_priority > 0:
            parts.append(f"{low_priority} low-priority actions")
        
        total_actions = len(follow_up_actions)
        if total_actions <= 3:
            # List specific actions if few
            action_descriptions = [a.get("description", "Unknown action") for a in follow_up_actions[:3]]
            return f"Follow-up needed: {', '.join(action_descriptions)}."
        else:
            return f"Follow-up needed: {total_actions} actions ({', '.join(parts)})."