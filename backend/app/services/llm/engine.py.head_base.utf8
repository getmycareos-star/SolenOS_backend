"""Orchestration for local-model reasoning.

The contract this engine offers to the rest of the backend is narrow on purpose:

    reason(...) -> LLMReasoningResult | None

It returns None whenever it could not produce something the trust guard is
willing to let exist: the model is off, unreachable, circuit-broken, slow,
unparseable, or answered with something the record cannot support. Every caller
is written to treat None as "use the deterministic answer instead", which is why
a stopped Ollama degrades the product rather than breaking it.

Every attempt, including the failures, is written to the llm_calls audit table.
"""

from __future__ import annotations

from typing import Any, Dict, List, Optional, Sequence

from sqlalchemy.orm import Session

from app.core.config import get_settings
from app.core.llm_enums import (
    LLMReasoningMode,
    LLMStatus,
    LLMTask,
    GuardVerdict,
)
from app.models.llm import LLMCall, LLMReasoningResult
from app.services.llm.circuit import CircuitBreaker
from app.services.llm.client import OllamaClient
from app.services.llm.prompts import get_prompt
from app.services.llm.trust_guard import TrustGuard


class LocalReasoningEngine:
    _breaker: Optional[CircuitBreaker] = None

    def __init__(self, db: Optional[Session] = None, client: Optional[OllamaClient] = None) -> None:
        self.db = db
        self._client = client
        self.settings = get_settings()
        self.enabled = self.settings.llm_enabled

    @classmethod
    def breaker(cls) -> CircuitBreaker:
        if cls._breaker is None:
            settings = get_settings()
            cls._breaker = CircuitBreaker(
                failure_threshold=settings.llm_circuit_failure_threshold,
                reset_seconds=settings.llm_circuit_reset_seconds,
            )
        return cls._breaker

    @classmethod
    def reset_circuit(cls) -> None:
        cls.breaker().reset()

    @property
    def client(self) -> OllamaClient:
        if self._client is None:
            self._client = OllamaClient()
        return self._client

    def is_available(self) -> bool:
        if not self.enabled:
            return False
        if self.breaker().is_open:
            return False
        ok, _ = self.client.is_available()
        return ok

    def health(self) -> Dict[str, Any]:
        settings = self.settings
        breaker = self.breaker()
        if not self.enabled:
            return {
                "enabled": False,
                "available": False,
                "status": LLMStatus.DISABLED.value,
                "base_url": settings.llm_base_url,
                "model": settings.llm_model,
                "circuit": breaker.state(),
                "consecutive_failures": breaker.consecutive_failures,
                "detail": "local reasoning is disabled by configuration",
            }
        breaker_open = breaker.is_open
        ok, detail = self.client.is_available()
        return {
            "enabled": True,
            "available": bool(ok and not breaker_open),
            "status": (
                LLMStatus.CIRCUIT_OPEN.value
                if breaker_open
                else (LLMStatus.OK.value if ok else LLMStatus.UNAVAILABLE.value)
            ),
            "base_url": settings.llm_base_url,
            "model": settings.llm_model,
            "circuit": breaker.state(),
            "consecutive_failures": breaker.consecutive_failures,
            "detail": detail,
        }

    def reason(
        self,
        task: Any,
        person_id: Optional[str] = None,
        payload: Optional[Dict[str, Any]] = None,
        evidence_ids: Optional[Sequence[str]] = None,
        evidence_texts: Optional[Dict[str, str]] = None,
        subject_type: Optional[str] = None,
        subject_id: Optional[str] = None,
        mode: LLMReasoningMode = LLMReasoningMode.LLM_ASSISTED,
        allow_diagnostic: bool = False,
        allow_medical_action: bool = False,
        require_evidence: bool = True,
    ) -> Optional[LLMReasoningResult]:
        """Run one guarded reasoning step.

        Returns the persisted result on success, or None when the caller should
        fall back to deterministic reasoning. Never raises.
        """
        task_value = _task_value(task)
        evidence_list = list(evidence_ids or [])

        if not self.enabled:
            self._audit(person_id, task_value, mode, LLMStatus.DISABLED, note="local reasoning disabled")
            return None
        if mode == LLMReasoningMode.DETERMINISTIC_ONLY:
            self._audit(
                person_id,
                task_value,
                mode,
                LLMStatus.OK,
                fallback=True,
                note="caller requested deterministic only",
            )
            return None
        if self.breaker().is_open:
            self._audit(
                person_id,
                task_value,
                mode,
                LLMStatus.CIRCUIT_OPEN,
                fallback=True,
                note="circuit open after repeated local-model failures",
                evidence_ids=evidence_list,
            )
            return None

        prompt = get_prompt(task_value)
        request_payload = dict(payload or {})

        ok, parsed, raw, meta = self.client.generate_json(prompt, request_payload)
        status = LLMStatus(meta.get("status", LLMStatus.ERROR.value))
        latency_ms = meta.get("latency_ms")

        if not ok:
            self.breaker().record_failure()
            self._audit(
                person_id,
                task_value,
                mode,
                status,
                latency_ms=latency_ms,
                error=raw or "local model call failed",
                evidence_ids=evidence_list,
                fallback=True,
            )
            return None

        self.breaker().record_success()

        guard = TrustGuard(
            permitted_evidence_ids=evidence_list,
            evidence_texts=evidence_texts,
            allow_diagnostic=allow_diagnostic,
            allow_medical_action=allow_medical_action,
            require_evidence=require_evidence,
        )

        # The conversation prompt asks for a different shape than every other
        # task: "reply" plus "grounded_claims" rather than "summary" plus
        # "evidence_ids". Guarding a conversational reply as an insight rejected
        # every one of them with "model returned no summary", which the caller
        # cannot distinguish from the model being unavailable, so the product
        # silently answered nothing at all. The guard is chosen to match the
        # shape the prompt actually asked for.
        if task_value == LLMTask.CONVERSATION_REPLY.value:
            guarded = guard.guard_conversation(parsed)
        else:
            guarded = guard.guard_insight(parsed)

        call = self._audit(
            person_id,
            task_value,
            mode,
            status,
            latency_ms=latency_ms,
            prompt=prompt,
            raw=raw,
            parsed=parsed,
            evidence_ids=evidence_list,
            output_evidence_ids=guarded.output_evidence_ids,
            dropped_evidence_ids=guarded.dropped_evidence_ids,
            guard_verdict=guarded.verdict,
            guard_reasons=guarded.reasons,
            error="; ".join(guarded.reasons) if guarded.verdict == GuardVerdict.REJECTED else None,
            prompt_tokens=meta.get("prompt_tokens"),
            completion_tokens=meta.get("completion_tokens"),
        )

        if not guarded.is_usable:
            return None

        record = LLMReasoningResult(
            person_id=person_id,
            task=task_value,
            call_id=call.id if call is not None else None,
            subject_type=subject_type,
            subject_id=subject_id,
            # A conversational reply is stored in the same column as a finding,
            # because the caller reads one field either way. Reading only
            # "summary" here would persist an empty string for every chat turn.
            summary=(
                guarded.payload.get("summary")
                or guarded.payload.get("reply")
                or ""
            ),
            detail=_build_detail(guarded.payload),
            evidence_ids=guarded.output_evidence_ids,
            possible_context=guarded.payload.get("possible_context"),
            confidence=guarded.confidence,
            guard_verdict=guarded.verdict,
            qualifications=guarded.qualifications or None,
        )
        if self.db is not None:
            try:
                self.db.add(record)
                self.db.flush()
            except Exception:
                # The audit row is the part that must survive: it is already
                # committed. Losing the enrichment is acceptable, losing the
                # record of having asked is not.
                try:
                    self.db.rollback()
                except Exception:
                    pass
                return None
        return record

    def _audit(
        self,
        person_id: Optional[str],
        task: str,
        mode: LLMReasoningMode,
        status: LLMStatus,
        latency_ms: Optional[int] = None,
        prompt: Optional[str] = None,
        raw: Optional[str] = None,
        parsed: Optional[Dict[str, Any]] = None,
        error: Optional[str] = None,
        note: Optional[str] = None,
        evidence_ids: Optional[Sequence[str]] = None,
        output_evidence_ids: Optional[Sequence[str]] = None,
        dropped_evidence_ids: Optional[Sequence[str]] = None,
        guard_verdict: Optional[GuardVerdict] = None,
        guard_reasons: Optional[List[str]] = None,
        prompt_tokens: Optional[int] = None,
        completion_tokens: Optional[int] = None,
        fallback: bool = False,
    ) -> Optional[LLMCall]:
        if self.db is None:
            return None
        try:
            record = LLMCall(
                person_id=person_id,
                task=task,
                mode=mode,
                model=self.settings.llm_model,
                status=status,
                guard_verdict=guard_verdict,
                guard_reasons=guard_reasons or None,
                prompt_text=prompt,
                raw_response=raw,
                parsed_output=parsed,
                error_detail=error or note,
                input_evidence_ids=list(evidence_ids) if evidence_ids else None,
                output_evidence_ids=list(output_evidence_ids) if output_evidence_ids else None,
                dropped_evidence_ids=list(dropped_evidence_ids) if dropped_evidence_ids else None,
                latency_ms=latency_ms,
                prompt_tokens=prompt_tokens,
                completion_tokens=completion_tokens,
                is_fallback=fallback,
            )
            self.db.add(record)
            self.db.commit()
            return record
        except Exception:
            try:
                self.db.rollback()
            except Exception:
                pass
            return None


def _build_detail(payload: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Keep the structured fields the caller cares about, drop the envelope."""
    detail: List[Dict[str, Any]] = []
    for key, value in payload.items():
        if key in ("summary", "evidence_ids", "confidence", "possible_context"):
            continue
        detail.append({"field": key, "value": value})
    return detail


def _task_value(task: Any) -> str:
    if isinstance(task, LLMTask):
        return task.value
    return task.value if hasattr(task, "value") else str(task)
