from typing import Callable
from fastapi import Request, Response
from starlette.middleware.base import BaseHTTPMiddleware
from observability.logging import set_correlation_id, logger
from observability.metrics import (
    increment_counter, 
    record_histogram, 
    set_gauge
)
from observability.tracing import (
    set_trace_context, 
    get_trace_id, 
    get_span_id,
    generate_trace_id
)
import time

class ObservabilityMiddleware(BaseHTTPMiddleware):
    """Middleware to add observability to HTTP requests"""
    
    async def dispatch(self, request: Request, call_next: Callable) -> Response:
        # Generate correlation ID for logging
        correlation_id = set_correlation_id()
        
        # Generate trace context for tracing
        trace_context = set_trace_context()
        trace_id = trace_context.trace_id
        span_id = trace_context.span_id
        
        # Add trace IDs to request state for use in endpoints
        request.state.trace_id = trace_id
        request.state.span_id = span_id
        request.state.correlation_id = correlation_id
        
        # Start timing
        start_time = time.time()
        
        # Increment request counter
        increment_counter(
            "http_requests_total", 
            tags={
                "method": request.method,
                "endpoint": request.url.path
            }
        )
        
        # Process request
        try:
            response = await call_next(request)
            status_code = response.status_code
            
            # Record successful request
            increment_counter(
                "http_requests_success_total",
                tags={
                    "method": request.method,
                    "endpoint": request.url.path,
                    "status_code": str(status_code)
                }
            )
            
            return response
            
        except Exception as e:
            # Record failed request
            increment_counter(
                "http_requests_failed_total",
                tags={
                    "method": request.method,
                    "endpoint": request.url.path,
                    "exception_type": type(e).__name__
                }
            )
            
            # Log the exception
            logger.error(
                f"Unhandled exception in request processing: {str(e)}",
                extra={
                    "exception_type": type(e).__name__,
                    "exception_message": str(e),
                    "method": request.method,
                    "url": str(request.url)
                },
                exc_info=True
            )
            
            raise
            
        finally:
            # Record request duration
            duration = time.time() - start_time
            record_histogram(
                "http_request_duration_seconds",
                duration,
                tags={
                    "method": request.method,
                    "endpoint": request.url.path
                }
            )
            
            # Update active requests gauge (approximation)
            # In a real implementation, you'd track this more precisely
            
            # Finish the span
            trace_context.finish()
            
            # Log request completion
            logger.info(
                f"{request.method} {request.url.path} completed",
                extra={
                    "method": request.method,
                    "path": request.url.path,
                    "status_code": getattr(locals().get('response', None), 'status_code', 0),
                    "duration_ms": duration * 1000,
                    "trace_id": trace_id,
                    "span_id": span_id,
                    "correlation_id": correlation_id
                }
            )

def setup_observability_middleware(app):
    """Setup observability middleware on FastAPI app"""
    app.add_middleware(ObservabilityMiddleware)
    
    # Add endpoint to expose metrics (for Prometheus scraping)
    @app.get("/metrics")
    async def metrics_endpoint():
        from observability.metrics import metrics
        from observability.logging import logger
        
        # Simple text format for metrics (Prometheus format)
        metric_data = metrics.get_all_metrics()
        
        output_lines = []
        
        # Counters
        for key, value in metric_data["counters"].items():
            output_lines.append(f"solenos_{key.replace(':', '_').replace('-', '_')} {value}")
        
        # Gauges
        for key, value in metric_data["gauges"].items():
            output_lines.append(f"solenos_{key.replace(':', '_').replace('-', '_')} {value}")
        
        # Histograms (simplified)
        for key, stats in metric_data["histograms"].items():
            if stats.get("count", 0) > 0:
                base_key = f"solenos_{key.replace(':', '_').replace('-', '_')}"
                output_lines.append(f"{base_key}_count {stats['count']}")
                output_lines.append(f"{base_key}_sum {stats['mean'] * stats['count']}")
                output_lines.append(f"{base_key}_bucket{{le=\"5.0\"}} {stats['count']}")  # Simplified
        
        # Uptime
        output_lines.append(f"solenos_uptime_seconds {metric_data['uptime_seconds']}")
        
        return "\n".join(output_lines)
    
    logger.info("Observability middleware configured")