# Copy to .env.local — NEVER commit .env.local
# Use Supabase PostgreSQL as the database provider.
# DATABASE_URL is the Supabase Postgres connection string (URI format).

GEMINI_API_KEY=
SOLENOS_GEMINI_MODEL=gemini-1.5-pro

# ─── Postgres (Supabase or any Postgres) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:%2FC88idXAQKq%40U7C@db.qyialgkfbwralolryhjx.supabase.co:5432/postgres

# ─── Supabase (optional, server only) ─────────────────────────────────────────
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=   # SERVER ONLY — never NEXT_PUBLIC

# ─── SolenOS Ops Console (internal) ───────────────────────────────────────────
# https://solenosai.netlify.app/ops?key=<OPS_SECRET>
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OPS_SECRET=

# ─── SolenOS Investor Metrics (aggregated only) ───────────────────────────────
# https://solenosai.netlify.app/metrics?key=<METRICS_SECRET>
METRICS_SECRET=

# ─── Voice Observation STT (OpenAI Whisper) ───────────────────────────────────
OPENAI_API_KEY=

# ─── TTS — Amazon Polly ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── TTS — Google Cloud Text-to-Speech ─────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=
